{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR attention classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "summary",
    "rationale",
    "blastRadius",
    "reviewFocus",
    "reviewerType",
    "missingEvidence"
  ],
  "properties": {
    "tier": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "blastRadius": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reviewFocus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "reviewerType": {
      "type": "string",
      "enum": ["NON_LEAD_DEVELOPER", "TECH_LEAD_OR_SME"]
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
