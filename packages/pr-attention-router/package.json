    "check:workflow": "node cli/checkWorkflow.ts"
  },
  "dependencies": {
    "nodemailer": "^10.0.14",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "typescript": "~5.9.0"
  }
