{
  "name": "@scope/pr-attention-router",
  "version": "0.1.0",
  "private": true,
  "description": "Classification-only PR attention routing with host-owned policy.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./lib/index.ts"
  },
  "files": [
    "cli",
    "lib",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
