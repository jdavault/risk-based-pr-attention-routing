{
  "version": 1,
  "pathRules": [
    {
      "id": "authorization",
      "tier": "HIGH",
      "patterns": ["^src/auth/"],
      "rationale": "Authorization behavior changed."
    },
    {
      "id": "shared-library",
      "tier": "MEDIUM",
      "patterns": ["^src/shared/"],
      "rationale": "Shared library behavior changed."
    }
  ],
  "productionFilePattern": "\\.(?:[cm]?[jt]sx?|css|html)$",
  "nonProductionFilePattern": "(^|/)(?:__tests__|tests?|docs)/|\\.(?:spec|test)\\.[cm]?[jt]sx?$",
  "testFilePattern": "(^|/)(?:__tests__|tests?)/|\\.(?:spec|test)\\.[cm]?[jt]sx?$",
  "productionFileThreshold": 5,
  "changedLineThreshold": 250
}
